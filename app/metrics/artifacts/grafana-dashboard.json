{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Health",
      "type": "row"
    },
    {
      "datasource": { "uid": "prometheus" },
      "description": "Milvus and Triton health as reported by the query metrics server.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 1, "text": "Dead" },
                "1": { "color": "green", "index": 0, "text": "Alive" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": 0 }]
          },
          "unit": "bool"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "imagesearch_component_health{instance=\"$instance\"}",
          "legendFormat": "{{component}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Component health",
      "type": "stat"
    },
    {
      "datasource": { "uid": "prometheus" },
      "description": "Process RSS for the Gradio query pod.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "imagesearch_memory_usage_bytes{instance=\"$instance\"}",
          "legendFormat": "{{worker_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Memory",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 4,
      "panels": [],
      "title": "Query",
      "type": "row"
    },
    {
      "datasource": { "uid": "prometheus" },
      "description": "clip_hybrid_query completions per second.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(imagesearch_queries_total{instance=\"$instance\"}[5m]))",
          "legendFormat": "queries/s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Query rate",
      "type": "stat"
    },
    {
      "datasource": { "uid": "prometheus" },
      "description": "Mean and p90 latency for successful clip_hybrid_query (encode + retrieve + rerank, no Sage downloads).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(imagesearch_query_duration_seconds_sum{operation=\"e2e\",status=\"success\",instance=\"$instance\"}[5m])) / sum(rate(imagesearch_query_duration_seconds_count{operation=\"e2e\",status=\"success\",instance=\"$instance\"}[5m]))",
          "legendFormat": "avg",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(imagesearch_query_duration_seconds_bucket{operation=\"e2e\",status=\"success\",instance=\"$instance\"}[5m])))",
          "legendFormat": "p90",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "E2E latency (avg / p90)",
      "type": "stat"
    },
    {
      "datasource": { "uid": "prometheus" },
      "description": "Share of successful queries that returned no hits.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.3 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 6 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(imagesearch_query_empty_total{instance=\"$instance\"}[5m])) / clamp_min(sum(rate(imagesearch_queries_total{status=\"success\",instance=\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "empty",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Empty-result rate",
      "type": "stat"
    },
    {
      "datasource": { "uid": "prometheus" },
      "description": "Failed clip_hybrid_query share.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 6 },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(imagesearch_queries_total{status=\"failure\",instance=\"$instance\"}[5m])) / clamp_min(sum(rate(imagesearch_queries_total{instance=\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "errors",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Query error rate",
      "type": "stat"
    },
    {
      "datasource": { "uid": "prometheus" },
      "description": "Mean latency of encode (Triton CLIP text), retrieve (Milvus hybrid_search), and rerank (local logits).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (operation) (rate(imagesearch_query_duration_seconds_sum{operation=~\"encode|retrieve|rerank\",status=\"success\",instance=\"$instance\"}[5m])) / sum by (operation) (rate(imagesearch_query_duration_seconds_count{operation=~\"encode|retrieve|rerank\",status=\"success\",instance=\"$instance\"}[5m]))",
          "legendFormat": "{{operation}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Stage latency (encode / retrieve / rerank)",
      "type": "timeseries"
    },
    {
      "datasource": { "uid": "prometheus" },
      "description": "E2E is ranked hits only. Gallery includes Sage image downloads for the Gradio UI.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (operation) (rate(imagesearch_query_duration_seconds_sum{operation=~\"e2e|gallery\",status=\"success\",instance=\"$instance\"}[5m])) / sum by (operation) (rate(imagesearch_query_duration_seconds_count{operation=~\"e2e|gallery\",status=\"success\",instance=\"$instance\"}[5m]))",
          "legendFormat": "{{operation}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Gallery vs e2e latency",
      "type": "timeseries"
    },
    {
      "datasource": { "uid": "prometheus" },
      "description": "Per-image Sage download latency (mean and p90).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 18 },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(imagesearch_query_duration_seconds_sum{operation=\"image_fetch\",status=\"success\",instance=\"$instance\"}[5m])) / sum(rate(imagesearch_query_duration_seconds_count{operation=\"image_fetch\",status=\"success\",instance=\"$instance\"}[5m]))",
          "legendFormat": "avg",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(imagesearch_query_duration_seconds_bucket{operation=\"image_fetch\",status=\"success\",instance=\"$instance\"}[5m])))",
          "legendFormat": "p90",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Image-fetch latency (avg / p90)",
      "type": "stat"
    },
    {
      "datasource": { "uid": "prometheus" },
      "description": "Average hits returned after UNALLOWED_NODES filter.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "decimals": 1,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 18 },
      "id": 12,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(imagesearch_query_results_sum{instance=\"$instance\"}[5m])) / clamp_min(sum(rate(imagesearch_query_results_count{instance=\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "hits",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Mean result count",
      "type": "stat"
    },
    {
      "datasource": { "uid": "prometheus" },
      "description": "Errors by component.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "cps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 18 },
      "id": 13,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (component) (rate(imagesearch_errors_total{instance=\"$instance\"}[5m]))",
          "legendFormat": "{{component}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Errors by component",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["imagesearch", "query"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(imagesearch_component_health,instance)",
        "description": "Scraped query-metrics instance (dev vs prod).",
        "includeAll": false,
        "label": "Instance",
        "name": "instance",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(imagesearch_component_health,instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Image Search Query",
  "uid": "imagesearch-query",
  "version": 1
}
