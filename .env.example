#Secrets
SAGE_USER=
SAGE_PASS=
HF_TOKEN=

# Milvus (NRP-managed for Compose and Kubernetes)
# https://nrp.ai/documentation/userdocs/ai/vector-database/
MILVUS_URI=https://milvus.nrp-nautilus.io:50051
# Required: username:password from NRP Milvus password page
MILVUS_TOKEN=
# NRP-provisioned database (do not create; admins own this)
MILVUS_DB=image_search_svc
MILVUS_COLLECTION=SageImageSearch

# Optional: seed empty Milvus collection from portable Hub parquet dataset
# (private; needs HF_TOKEN). Leave unset/empty to skip. Skip if collection already has rows.
# INIT_DATASET=sagecontinuum/init_img_search
# INIT_DATASET_REVISION=main
# INIT_DATASET_BATCH_SIZE=256

#triton
# Ensure this path matches the model repository directory 
MODEL_REPOSITORY=/app/models
CLIP_HF_REPO=apple/DFN5B-CLIP-ViT-H-14-378
CLIP_MODEL_PATH=/models/clip
CLIP_MODEL_VERSION=419d1f8f6a96aabaf5913c526d059facda50c24b
GEMMA_MODEL_PATH=/models/gemma-3-4b-it
GEMMA_MODEL_VERSION=093f9f388b31de276ce2de164bdc2081324b9767

#weavloader
TRITON_HOST=triton
TRITON_PORT=8001
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
UNALLOWED_NODES="W042,N001,V012,W015,W01C,W01E,W024,W026,W02C,W02D,W02E,W02F,W031,W040,W046,W047,W048,W049,W04A,W051,W055,W059,W05A,W05B,W05C,W05D,W05E,W05F,W060,W061,W062,W063,W064,W065,W066,W06E,W072,W073,W074,W075,W076,W077,W078,W079,W07A,W07B,W07D,W07E,W07F,W080,W081,W086,W088,W089,W08A,W08B,W08D,W08E,W08F,W090,W091,W092,W094,W096,W099,W09B,W09E,W0A0,W0A1,W0BB,W0BC"
LOG_LEVEL='INFO'
MONITOR_DATA_STREAM_INTERVAL=60
MONITOR_DATA_STREAM_QUERY_DELAY_MINUTE=5
LLM_RUN_MODE=TRITON
# IF LLM_RUN_MODE is set to NRP
# NRP_API_KEY=
# NRP_API_ENDPOINT=
# NRP_LLM_MODEL=

#gradio-ui
CLUSTER_FLAG=True
