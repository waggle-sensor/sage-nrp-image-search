name: "gemma3"
backend: "python"
max_batch_size: 2

dynamic_batching { }

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

input [
  {
    name: "image"
    data_type: TYPE_UINT8
    dims: [-1, -1, 3] # -1 means any value greater-or-equal-to 0.
    allow_ragged_batch: true
  },
  {
    name: "prompt"
    data_type: TYPE_STRING
    dims: [1]
  }
]

output [
  {
    name: "answer"
    data_type: TYPE_STRING
    dims: [1]
  }
]
