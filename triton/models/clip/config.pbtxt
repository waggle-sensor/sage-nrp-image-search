name: "clip"
backend: "python"
max_batch_size: 8

dynamic_batching { }

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

input [
  {
    name: "text"
    data_type: TYPE_STRING
    dims: [1]
  },
  {
    name: "image"
    data_type: TYPE_FP32
    dims: [-1, -1, 3] # -1 means any value greater-or-equal-to 0.
    allow_ragged_batch: true
  }
]

output [
  {
    name: "text_embedding"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "image_embedding"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    # Multiplicative scale used by HF CLIPModel.forward for logits_per_image:
    #   logits_per_image = cosine(image, text) * logit_scale
    # Value is exp(model.logit_scale), shape [batch, 1].
    name: "logit_scale"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]
